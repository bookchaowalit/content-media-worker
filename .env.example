# Copy to .env.local (git-ignored) and fill only what you use. Never commit real values.
# Speech-to-text: set one or more; the router picks the best configured provider.
SPEECHMATICS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
GLADIA_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Summary through the Central AI Gateway (scoped token with ai:generate).
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
# OneDrive worker only.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_ROOT_PATH=/Transcribe
MEDIA_STATE=file
MEDIA_SINK=onedrive
